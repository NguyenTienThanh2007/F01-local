OPENAI_API_KEY=
# Phase 2A OIDC: configure these backend-only values to enable verified identity.
# SESSION_ENCRYPTION_KEY=
# OIDC_ISSUER=
# OIDC_AUTHORIZATION_URL=
# OIDC_TOKEN_URL=
# OIDC_JWKS_URL=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_API_AUDIENCE=
# OIDC_REDIRECT_URI=
# SESSION_TTL_SECONDS=3600
# SESSION_IDLE_SECONDS=900
# PLANNING_REQUESTS_PER_MINUTE=5
# PLANNING_REQUESTS_PER_DAY=30
# PLANNING_DAILY_TOKEN_BUDGET=200000
# PLANNING_CONTEXT_BYTES=24000
# PLANNING_INPUT_TOKENS=28000
# PLANNING_OUTPUT_TOKENS=3000
# PLANNING_TIMEOUT_SECONDS=30

# Phase 2B is disabled until exact-image Docker acceptance passes.
REAL_EXECUTION_ENABLED=false
SANDBOX_IMAGE_ID=
SANDBOX_ACCEPTANCE_REPORT=
SANDBOX_SOCKET=/var/run/docker.sock
FACTORY_ORIGIN=http://localhost:3000
PREVIEW_ORIGIN=http://127.0.0.1:3031
BUILD_CONCURRENCY=1
BUILD_TIMEOUT_SECONDS=600
REPAIR_ATTEMPTS=2
SOURCE_OUTPUT_TOKENS=8000
SOURCE_RUN_TOKEN_BUDGET=350000
PREVIEW_TTL_SECONDS=3600

# Auth0 regular web application (server only). See QA/premium-auth/AUTHENTICATION.md.
# Use hosted Classic Login / Lock passwordlessMethod: 'link' for email magic links.
# OIDC_GOOGLE_CONNECTION=google-oauth2
# OIDC_EMAIL_CONNECTION=email
# OIDC_REQUIRE_VERIFIED_EMAIL=true
# Configure production Google OAuth keys and a production SMTP sender in Auth0.
# Provider endpoints, client secret and session key above are required; no defaults.
