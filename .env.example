APP_ENV=development
AUTH_MODE=development
EXECUTION_MODE=simulated
DATABASE_URL=postgresql+psycopg://f01:replace-me@127.0.0.1:5432/f01
API_INTERNAL_URL=http://127.0.0.1:8000
# Generate a private random value of at least 32 characters; never commit it.
DEV_API_TOKEN=
DEV_AUTH_SUBJECT=founder-development
NEXT_PUBLIC_APP_URL=http://localhost:3000
SIMULATION_TICK_MS=1000
SIMULATION_RUNNER_ENABLED=true
# Failure fixtures are permitted only with APP_ENV=development or test.
SIMULATION_CHANGE_SCENARIO=auto
# Optional UTC credential expiry; leave unset for normal local development.
# DEV_TOKEN_EXPIRES_AT=2026-12-31T23:59:59Z
LOG_LEVEL=INFO

# Phase 2A: only required when AUTH_MODE=oidc. Keep this server-only.
AUTH_GATEWAY_TOKEN=
# Provider/session encryption configuration belongs in apps/api/.env.

# Commercial-v1 production packaging; disabled until exact-image acceptance passes.
RELEASE_ENABLED=false
PRODUCTION_IMAGE_ID=
PRODUCTION_ACCEPTANCE_REPORT=
RELEASE_CONCURRENCY=1
RELEASE_TIMEOUT_SECONDS=600
# F01_VERCEL_TOKEN and optional F01_VERCEL_TEAM_ID belong ONLY to the separate
# release-worker service secret environment, never to this shared factory file.
